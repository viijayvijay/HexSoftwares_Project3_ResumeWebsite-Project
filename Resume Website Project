<!DOCTYPE html>
<html>

<head>
    <title>Animal Charity Website</title>

    <style>

        /* Body */

        body {
            margin: 0;
            font-family: Arial;
            background-color: #f4f4f4;
        }

        /* Navbar */

        .navbar {
            background-color: black;
            padding: 15px;
            text-align: center;
        }

        .navbar a {
            color: white;
            text-decoration: none;
            margin: 10px;
            font-size: 18px;
        }

        .navbar a:hover {
            color: orange;
        }

        /* Home Section */

        .home {
            background-color: #333;
            color: white;
            text-align: center;
            padding: 80px;
        }

        .home h1 {
            font-size: 40px;
        }

        .home button {
            padding: 10px 20px;
            background-color: orange;
            border: none;
            font-size: 18px;
            cursor: pointer;
            border-radius: 5px;
        }

        .home button:hover {
            background-color: darkorange;
        }

        /* Common Section */

        .section {
            padding: 40px;
            text-align: center;
        }

        /* Program Boxes */

        .box {
            background-color: white;
            width: 250px;
            margin: 20px auto;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0px 0px 10px gray;
        }

        /* Donate Button */

        .donate-btn {
            padding: 10px 20px;
            background-color: green;
            color: white;
            border: none;
            font-size: 18px;
            cursor: pointer;
            border-radius: 5px;
        }

        .donate-btn:hover {
            background-color: darkgreen;
        }

        /* Contact */

        .contact {
            background-color: black;
            color: white;
            padding: 30px;
            text-align: center;
        }

        /* Footer */

        footer {
            background-color: #222;
            color: white;
            text-align: center;
            padding: 10px;
        }

    </style>
</head>

<body>

    <!-- Navbar -->

    <div class="navbar">

        <a href="#home">Home</a>

        <a href="#mission">Mission</a>

        <a href="#programs">Programs</a>

        <a href="#donate">Donate</a>

        <a href="#contact">Contact</a>

    </div>

    <!-- Home Section -->

    <div class="home" id="home">

        <h1>Save Animals 🐾</h1>

        <p>Help and protect homeless animals.</p>

        <button onclick="supportMessage()">
            Support Us
        </button>

    </div>

    <!-- Mission Section -->

    <div class="section" id="mission">

        <h2>Our Mission</h2>

        <p>
            Our mission is to rescue injured and homeless animals
            and provide them with food, shelter, and medical care.
        </p>

    </div>

    <!-- Programs Section -->

    <div class="section" id="programs">

        <h2>Our Programs</h2>

        <div class="box">

            <h3> Animal Rescue</h3>

            <p>Helping injured street animals.</p>

        </div>

        <div class="box">

            <h3> Adoption</h3>

            <p>Finding loving homes for animals.</p>

        </div>

        <div class="box">

            <h3> Feeding Program</h3>

            <p>Providing food for hungry animals.</p>

        </div>

    </div>

    <!-- Donate Section -->

    <div class="section" id="donate">

        <h2>Donate</h2>

        <p>Your donation helps save more animals.</p>

        <button class="donate-btn" onclick="donateMessage()">
            Donate Now
        </button>

    </div>

    <!-- Contact Section -->

    <div class="contact" id="contact">

        <h2>Contact Us</h2>

        <p> Hyderabad, India</p>

        <p> +91 9876543210</p>

        <p> animalcare@email.com</p>

    </div>

    <!-- Footer -->

    <footer>

        <p>© 2026 Animal Charity Website</p>

    </footer>

    <!-- JavaScript -->

    <script>

        // Support Button

        function supportMessage() {

            alert("Thank you for supporting animals 🐾");

        }

        // Donate Button

        function donateMessage() {

            alert("Donation feature coming soon ");

        }

    </script>

</body>

</html>
